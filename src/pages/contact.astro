---
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkHero from '../components/DarkHero.astro';

const EMAIL = 'jyozspace@gmail.com';

const socials = [
  { label: 'GitHub', href: 'https://github.com/jyothish2312' },
  { label: 'LinkedIn', href: 'http://www.linkedin.com/in/jyothishkj' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UCJNfn2usGWhr9XHlWwgIbdw' },
  { label: 'Instagram', href: 'https://www.instagram.com/jyozspace/' },
  { label: 'Twitter', href: 'https://twitter.com/JyothishKrJ' },
  { label: 'Facebook', href: 'https://www.facebook.com/jyotish.kumar.1232/' },
];

// TODO (Jyothish): sign up free at https://formspree.io, create a form, and
// replace YOUR_FORM_ID below with the id it gives you. Until then this form
// will not actually deliver anywhere — see README.md for the 2-minute setup.
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xaewzzjw';
---

<BaseLayout title="Contact" description="Get in touch with Jyothish J. Kumar.">
  <DarkHero compact>
    <span class="eyebrow">✉️ Contact</span>
    <h1>Let's <span class="text-gradient">talk</span></h1>
    <p class="lede">
      I'm open to robotics-focused roles and collaborations. Reach out for hiring enquiries,
      collaboration ideas, or just to say hi.
    </p>
  </DarkHero>

  <section class="section section-alt">
    <div class="container contact-grid">
      <form class="card contact-form" action={FORMSPREE_ENDPOINT} method="POST">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>

      <div class="contact-side">
        <div class="card">
          <h4>Email</h4>
          <a class="contact-email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <p class="contact-note">
            I try to reply to every message. Please avoid spam — genuine enquiries and
            collaboration ideas are always welcome.
          </p>
        </div>
        <div class="card">
          <h4>Elsewhere</h4>
          <ul class="social-list">
            {socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .field input,
  .field textarea {
    font: inherit;
    padding: 0.65em 0.8em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .contact-form button { align-self: flex-start; }

  .contact-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-side h4 { margin-bottom: 0.6rem; }

  .contact-email {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  .contact-note {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-list a {
    text-decoration: none;
    font-weight: 600;
    color: var(--text);
  }
  .social-list a:hover { color: var(--accent-strong); }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
