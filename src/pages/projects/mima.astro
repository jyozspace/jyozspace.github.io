---
// Standalone product-pitch page for MIMA, served at /projects/mima/.
// Deliberately does NOT use BaseLayout / the site Header+Footer — it is meant
// to read as its own small product site. Content is distilled from the MIMA
// pitch deck (C:/Users/jyoti/OneDrive/Desktop/Projects/MIMA/MIMA Deck.pptx)
// and the interactive demo that lives at /projects/mima/demo/.
const patentNo = '202531001119';
const canonical = 'https://jyozspace.in/projects/mima/';
const description =
  'MIMA — a Multifunctional IoT Integrated Menstrual Aid. One platform combining a specialised garment, closed-loop heat therapy, physiological sensing, and a care app. Indian Patent Application No. 202531001119, currently in hearing.';

const nodes = [
  {
    tag: 'Node 1',
    title: 'Specialised undergarment',
    points: [
      'High-waisted construction for a stable, discreet fit',
      'Leak-proof multilayer gusset',
      'Antibacterial material against rashes and malodor',
      'Wing-pockets that receive sanitary-pad wings, keeping them off the skin',
    ],
  },
  {
    tag: 'Node 2',
    title: 'Detachable IoT module',
    points: [
      'Safe, controlled, targeted heat therapy for cramps',
      'Physiological sensing — muscle activity, pulse rate, intimate-area temperature',
      'Closed-loop control: heat scales to real-time cramp intensity',
      'Wireless communication with the app',
    ],
  },
  {
    tag: 'Node 3',
    title: 'App & care ecosystem',
    points: [
      'Menstrual-cycle tracking and IoT module control',
      'Physiological-data visualisation, export-ready for clinicians',
      'Community network and anonymous emergency menstrual support',
      'Gynaecological support ecosystem',
    ],
  },
];

const novelty = [
  {
    title: 'Synergistic wearable ecosystem',
    body:
      'The core novelty is the functional integration of a multi-modal sensor suite, automated therapeutic heat, a specialised garment, and a socially connected app into one coordinated system.',
  },
  {
    title: 'Engineered textile integration',
    body:
      'The high-waisted hipster architecture is structurally critical — it holds the ~10% sustained skin strain needed for motion-stable, high-fidelity textile sEMG readings.',
  },
  {
    title: 'Closed-loop bio-responsivity',
    body:
      'Unlike a manual heating pad, integrated sEMG sensors automate actuation and thermal scaling of the heater in response to the real-time occurrence and intensity of abdominal muscle contractions.',
  },
  {
    title: 'Advanced physiological analytics',
    body:
      'Simultaneous EMG, pulse and temperature acquisition into one framework enables richer, "hyper-semantic" wellness tracking and visualisations relevant to gynaecological consultations.',
  },
  {
    title: 'Community & digital support',
    body:
      'The app goes beyond hardware control with a secure "request a pad" network and community forums for menstrual well-being.',
  },
  {
    title: 'Consolidated menstrual management',
    body:
      'Integrating these physical and digital features removes the dependency on multiple fragmented menstrual-care products.',
  },
];

const compare = [
  ['Cramp heat therapy', 'Separate electric or gel pad, adjusted by hand', 'Built into the garment, app- or auto-controlled'],
  ['Responds to cramp intensity', 'No', 'Closed-loop sEMG auto-scaling'],
  ['Leak protection', 'Pad or period underwear alone', 'High-waisted garment + multilayer leak-proof gusset + pad wing-pockets'],
  ['Friction-rash prevention', 'Not addressed', 'Antibacterial fabric; wing-pockets hold pad wings off the skin'],
  ['Physiological tracking', 'Separate smartwatch or app, mostly estimated', 'Onboard intimate-area temperature, pulse, muscle activity'],
  ['Clinician-ready data', 'Manual notes', 'One-tap analytics export'],
  ['Peer & emergency support', 'Ad hoc', 'In-app community + anonymous "request a pad" network'],
  ['Products to buy & carry', 'Three to four', 'One platform'],
];

const screens = [
  ['Device', 'Connection status, Auto (EMG closed-loop) vs Manual mode, target-temperature dial, heating toggle, session timer, and live physiological sensing.'],
  ['Insights', 'Cramp intensity by time of day, cycle overview and prediction, pain trend per cycle, pain vs muscle activity, sleep by cycle phase, and a clinician export.'],
  ['Community', 'A forum for menstrual health — groups, upvotes, threaded comments, posting as yourself or anonymously.'],
  ['Assistance', 'Book teleconsultations with gynaecologists, chat, video call, and granular control over what physiological data a clinician can see.'],
  ['Emergency (SOS)', 'A floating button on every screen — broadcast a request (pad, painkiller, custom) to verified users nearby, named or anonymous.'],
  ['Profile', 'Account, device management, preferences, and privacy & data controls.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/projects/mima/assets/mima-logo.png" />
    <link rel="canonical" href={canonical} />
    <title>MIMA — Multifunctional IoT Integrated Menstrual Aid</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MIMA — Multifunctional IoT Integrated Menstrual Aid" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://jyozspace.in/projects/mima/assets/mima-logo.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#8E4EC6" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Nunito:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <style is:global>
      :root {
        --font-display: 'Fraunces', 'Iowan Old Style', Georgia, serif;
        --font-sans: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

        --bg: #fbf6fb;
        --bg-alt: #f4ebf6;
        --surface: #ffffff;
        --text: #291733;
        --muted: #6c5b76;
        --border: #ecdcef;
        --plum: #6d28a8;
        --purple: #8e4ec6;
        --pink: #ec6fa9;
        --grad: linear-gradient(135deg, #8e4ec6 0%, #ec6fa9 100%);
        --ring: rgba(142, 78, 198, 0.28);
        --shadow: 0 18px 48px -24px rgba(74, 32, 110, 0.45);

        color-scheme: light;
      }

      :root[data-theme='dark'] {
        --bg: #130c1b;
        --bg-alt: #1a1126;
        --surface: #211630;
        --text: #f4eef8;
        --muted: #b8a7c6;
        --border: #362744;
        --plum: #d9b8f5;
        --purple: #b98be6;
        --pink: #f394bf;
        --grad: linear-gradient(135deg, #a56fd8 0%, #f08bbb 100%);
        --ring: rgba(185, 139, 230, 0.35);
        --shadow: 0 20px 52px -22px rgba(0, 0, 0, 0.7);

        color-scheme: dark;
      }

      * ,
      *::before,
      *::after { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 1.05rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      img { max-width: 100%; height: auto; display: block; }

      h1, h2, h3 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.01em;
        margin: 0 0 0.5em;
        color: var(--text);
      }
      h1 { font-size: clamp(2rem, 4.5vw + 1rem, 4rem); font-weight: 600; overflow-wrap: break-word; }
      h2 { font-size: clamp(1.8rem, 3vw + 1rem, 2.6rem); }
      h3 { font-size: 1.2rem; font-weight: 600; }
      p { margin: 0 0 1.1em; }
      a { color: inherit; }

      .wrap {
        width: 100%;
        max-width: 74rem;
        margin-inline: auto;
        padding-inline: 1.5rem;
      }
      .narrow { max-width: 52rem; }

      section { padding-block: clamp(3.5rem, 8vw, 6.5rem); }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--plum);
        background: color-mix(in srgb, var(--purple) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--purple) 22%, transparent);
        padding: 0.4em 0.95em;
        border-radius: 999px;
        margin-bottom: 1.3rem;
        flex-wrap: wrap;
        white-space: normal;
      }
      .eyebrow .dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--pink);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--pink) 25%, transparent);
      }

      .grad-text {
        background: var(--grad);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55em;
        padding: 0.8em 1.5em;
        border-radius: 999px;
        font-family: var(--font-sans);
        font-weight: 800;
        font-size: 0.98rem;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid transparent;
        transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease,
          background-color 0.15s ease, color 0.15s ease;
      }
      .btn svg { width: 1.1em; height: 1.1em; }
      .btn-primary {
        background: var(--grad);
        color: #fff;
        box-shadow: 0 14px 30px -12px var(--ring);
      }
      .btn-primary:hover { transform: translateY(-2px); filter: brightness(1.07); }
      .btn-ghost {
        background: var(--surface);
        color: var(--text);
        border-color: var(--border);
      }
      .btn-ghost:hover { transform: translateY(-2px); border-color: var(--purple); color: var(--plum); }

      /* ---------- top nav ---------- */
      .nav {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        border-bottom: 1px solid var(--border);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.75rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.15rem;
        text-decoration: none;
        color: var(--text);
      }
      .brand img { width: 30px; height: 30px; }
      .nav-links { display: flex; align-items: center; gap: 0.4rem; }
      .nav-links a {
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        color: var(--muted);
        padding: 0.45em 0.8em;
        border-radius: 999px;
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .nav-links a:hover { color: var(--plum); background: var(--bg-alt); }
      .nav-links a.cta { color: #fff; background: var(--grad); }
      .nav-links a.cta:hover { color: #fff; filter: brightness(1.07); }
      @media (max-width: 640px) {
        .nav-links a.back { display: none; }
      }

      /* ---------- hero ---------- */
      .hero {
        position: relative;
        overflow: hidden;
        padding-top: clamp(3rem, 7vw, 5rem);
      }
      .hero::before,
      .hero::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        pointer-events: none;
        z-index: 0;
      }
      .hero::before { width: 30rem; height: 30rem; background: rgba(142, 78, 198, 0.28); top: -12rem; left: -10rem; }
      .hero::after { width: 26rem; height: 26rem; background: rgba(236, 111, 169, 0.22); bottom: -14rem; right: -8rem; }
      .hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
      }
      .hero-grid > * { min-width: 0; }
      .hero p.lede {
        font-size: 1.2rem;
        color: var(--muted);
        max-width: 34rem;
      }
      .hero-quote {
        margin: 1.6rem 0 2rem;
        padding-left: 1.1rem;
        border-left: 3px solid var(--pink);
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.12rem;
        color: var(--text);
        max-width: 34rem;
      }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
      .hero-visual {
        position: relative;
        display: grid;
        place-items: center;
      }
      .hero-visual .blob {
        position: absolute;
        inset: 6%;
        background: var(--grad);
        border-radius: 46% 54% 62% 38% / 54% 42% 58% 46%;
        opacity: 0.16;
        filter: blur(4px);
      }
      .hero-visual img {
        position: relative;
        width: min(78%, 320px);
        filter: drop-shadow(0 24px 44px rgba(74, 32, 110, 0.32));
      }
      @media (max-width: 860px) {
        .hero-grid { grid-template-columns: minmax(0, 1fr); }
        .hero-visual { order: -1; }
        .hero-visual img { width: min(56%, 240px); }
      }

      .patent-strip {
        position: relative;
        z-index: 1;
        margin-top: clamp(2.5rem, 5vw, 3.5rem);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.4rem;
        padding: 1rem 1.3rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: var(--shadow);
        font-size: 0.92rem;
      }
      .patent-strip strong { color: var(--plum); }
      .patent-strip .sep { width: 1px; height: 1.2em; background: var(--border); }
      @media (max-width: 620px) { .patent-strip .sep { display: none; } }
      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-weight: 800;
        color: var(--plum);
      }
      .status-pill .pulse {
        width: 9px; height: 9px; border-radius: 50%;
        background: var(--pink);
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--pink) 60%, transparent);
        animation: pulse 2.4s ease-out infinite;
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--pink) 55%, transparent); }
        70% { box-shadow: 0 0 0 12px transparent; }
        100% { box-shadow: 0 0 0 0 transparent; }
      }
      @media (prefers-reduced-motion: reduce) {
        .status-pill .pulse { animation: none; }
        html { scroll-behavior: auto; }
      }

      .alt { background: var(--bg-alt); }

      .section-head { max-width: 40rem; margin-bottom: 2.6rem; }
      .section-head p { color: var(--muted); margin-bottom: 0; }

      /* ---------- problem ---------- */
      .problem-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.1rem;
      }
      .problem {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.4rem;
      }
      .problem .ico {
        width: 40px; height: 40px;
        display: grid; place-items: center;
        border-radius: 12px;
        background: color-mix(in srgb, var(--purple) 12%, transparent);
        color: var(--plum);
        margin-bottom: 0.9rem;
      }
      .problem .ico svg { width: 22px; height: 22px; }
      .problem h3 { margin-bottom: 0.3em; }
      .problem p { color: var(--muted); font-size: 0.96rem; margin-bottom: 0; }

      .juggle {
        margin-top: 2rem;
        padding: 1.4rem 1.5rem;
        border: 1px dashed color-mix(in srgb, var(--purple) 40%, transparent);
        border-radius: 16px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 0.9rem;
        background: color-mix(in srgb, var(--purple) 6%, transparent);
      }
      .juggle b { font-family: var(--font-display); font-weight: 600; }
      .juggle .chip {
        font-weight: 700;
        font-size: 0.86rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.35em 0.85em;
      }
      .juggle .arrow { color: var(--pink); font-weight: 800; }

      /* ---------- anatomy ---------- */
      .anatomy {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: center;
      }
      .anatomy figure {
        margin: 0;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 1.2rem;
        box-shadow: var(--shadow);
      }
      .anatomy figcaption {
        margin-top: 0.7rem;
        font-size: 0.85rem;
        color: var(--muted);
        text-align: center;
      }
      .callouts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
      .callouts li {
        display: flex;
        gap: 0.7rem;
        align-items: flex-start;
        font-size: 0.98rem;
      }
      .callouts li::before {
        content: '';
        flex: none;
        width: 10px; height: 10px;
        margin-top: 0.5em;
        border-radius: 3px;
        background: var(--grad);
      }
      @media (max-width: 820px) {
        .anatomy { grid-template-columns: 1fr; }
      }

      /* ---------- architecture ---------- */
      .nodes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.2rem;
      }
      .node {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.5rem 1.4rem;
        overflow: hidden;
      }
      .node::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 4px;
        background: var(--grad);
      }
      .node .tag {
        font-weight: 800;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pink);
      }
      .node h3 { margin: 0.3em 0 0.7em; }
      .node ul { margin: 0; padding-left: 1.1em; }
      .node li { margin-bottom: 0.4em; color: var(--muted); font-size: 0.95rem; }
      .node li::marker { color: var(--purple); }

      /* ---------- loop ---------- */
      .loop {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.8rem;
        margin-top: 1rem;
      }
      .loop .step {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.1rem 1rem;
        text-align: center;
        position: relative;
      }
      .loop .step .n {
        font-family: var(--font-display);
        font-size: 1.4rem;
        color: var(--purple);
      }
      .loop .step p { margin: 0.3em 0 0; font-size: 0.9rem; color: var(--muted); }
      .loop .step:not(:last-child)::after {
        content: '→';
        position: absolute;
        right: -0.62rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--pink);
        font-weight: 800;
        z-index: 1;
      }
      @media (max-width: 720px) {
        .loop { grid-template-columns: 1fr 1fr; }
        .loop .step:nth-child(2)::after { display: none; }
      }

      /* ---------- novelty ---------- */
      .novelty-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.2rem;
        counter-reset: nv;
      }
      .nv {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem 1.4rem;
      }
      .nv::before {
        counter-increment: nv;
        content: counter(nv, decimal-leading-zero);
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--pink);
      }
      .nv h3 { margin: 0.25em 0 0.4em; font-size: 1.08rem; }
      .nv p { margin: 0; color: var(--muted); font-size: 0.95rem; }

      /* ---------- comparison ---------- */
      .table-scroll { overflow-x: auto; border-radius: 16px; border: 1px solid var(--border); }
      table.cmp {
        width: 100%;
        border-collapse: collapse;
        min-width: 620px;
        background: var(--surface);
      }
      table.cmp th, table.cmp td {
        text-align: left;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.94rem;
        vertical-align: top;
      }
      table.cmp thead th {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1rem;
        background: var(--bg-alt);
      }
      table.cmp thead th:last-child { color: var(--plum); }
      table.cmp tbody tr:last-child td { border-bottom: none; }
      table.cmp td:first-child { font-weight: 700; }
      table.cmp td:last-child { color: var(--text); }
      table.cmp td:nth-child(2) { color: var(--muted); }

      /* ---------- app ---------- */
      .app {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: start;
      }
      .app-card { position: sticky; top: 5rem; }
      @media (max-width: 820px) {
        .app-card { position: static; }
      }
      .app-card {
        background: var(--grad);
        border-radius: 24px;
        padding: 2rem;
        color: #fff;
        box-shadow: var(--shadow);
      }
      .app-card h3 { color: #fff; }
      .app-card p { color: rgba(255, 255, 255, 0.9); margin-bottom: 1.4rem; }
      .app-card .btn-ghost {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.3);
        color: #fff;
      }
      .app-card .btn-ghost:hover { background: rgba(255, 255, 255, 0.26); color: #fff; }
      .screens { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
      .screens li {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0.9rem 1.1rem;
      }
      .screens b { color: var(--plum); font-family: var(--font-display); font-weight: 600; }
      .screens p { margin: 0.15em 0 0; font-size: 0.92rem; color: var(--muted); }
      @media (max-width: 820px) {
        .app { grid-template-columns: 1fr; }
      }

      /* ---------- patent ---------- */
      .patent-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--purple);
        border-radius: 14px;
        padding: 1.6rem 1.7rem;
      }
      .patent-box p:last-child { margin-bottom: 0; }
      .patent-box .num {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--plum);
      }

      /* ---------- footer ---------- */
      footer {
        border-top: 1px solid var(--border);
        padding-block: 2.6rem;
        font-size: 0.9rem;
        color: var(--muted);
      }
      footer .foot-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
      }
      footer a { color: var(--plum); text-decoration: none; font-weight: 700; }
      footer a:hover { text-decoration: underline; }
      footer .foot-links { display: flex; gap: 1.1rem; flex-wrap: wrap; }
      .disclaimer { margin-top: 1rem; font-size: 0.82rem; opacity: 0.8; }
    </style>
  </head>

  <body>
    <nav class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/projects/mima/">
          <img src="/projects/mima/assets/mima-logo.png" alt="" />
          MIMA
        </a>
        <div class="nav-links">
          <a class="back" href="https://jyozspace.in/projects/">← Projects</a>
          <a class="cta" href="/projects/mima/demo/">Open the demo app</a>
        </div>
      </div>
    </nav>

    <header class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <span class="eyebrow"><span class="dot"></span>Indian patent pending &middot; App. No. {patentNo}</span>
            <h1>One system for <span class="grad-text">everything menstrual health</span> needs</h1>
            <p class="lede">
              MIMA — a <strong>Multifunctional IoT Integrated Menstrual Aid</strong>. A specialised
              garment, closed-loop heat therapy, physiological sensing, and a care app, working as
              one coordinated platform instead of four disconnected products.
            </p>
            <p class="hero-quote">
              “A multifunctional wearable menstrual management platform integrating a specially
              configured menstrual undergarment, targeted IoT-enabled heat therapy, physiological
              monitoring, and digital health management into a single coordinated system.”
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="/projects/mima/demo/">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="7" y="2" width="10" height="20" rx="2.5" /><line x1="11" y1="18" x2="13" y2="18" />
                </svg>
                Try the interactive demo
              </a>
              <a class="btn btn-ghost" href="#architecture">How it works</a>
            </div>
          </div>
          <div class="hero-visual">
            <div class="blob" aria-hidden="true"></div>
            <img src="/projects/mima/assets/mima-logo.png" alt="MIMA" width="516" height="516" />
          </div>
        </div>

        <div class="patent-strip">
          <span class="status-pill"><span class="pulse"></span>Currently in patent hearing</span>
          <span class="sep" aria-hidden="true"></span>
          <span>Application No. <strong>{patentNo}</strong> · filed 2025, India</span>
          <span class="sep" aria-hidden="true"></span>
          <span>Jyothish Kumar J <em>et al.</em> · NIFT Bhubaneswar</span>
        </div>
      </div>
    </header>

    <section class="alt" id="problem">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">The problem</span>
          <h2>Menstrual care today is fragmented</h2>
          <p>
            Isolated solutions exist for separate menstrual problems. Managing a period well can
            mean buying, charging, and carrying several unrelated products — with no shared picture
            of what is actually happening in your body.
          </p>
        </div>

        <div class="problem-grid">
          <div class="problem">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s6 5.5 6 11a6 6 0 0 1-12 0c0-5.5 6-11 6-11z"/></svg></span>
            <h3>Cramps</h3>
            <p>Dysmenorrhea handled with a separate heating pad or gel pack that you adjust by hand.</p>
          </div>
          <div class="problem">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v6"/><path d="M5 13a7 7 0 0 0 14 0c0-3-3-6-7-10-4 4-7 7-7 10z"/></svg></span>
            <h3>Leakage &amp; stains</h3>
            <p>Pads shift, underwear alone is not enough, and the anxiety of a stain is constant.</p>
          </div>
          <div class="problem">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8"/></svg></span>
            <h3>Rashes &amp; friction</h3>
            <p>Adhesive-backed pads and pad wings rub against skin, causing friction rashes and irritation.</p>
          </div>
          <div class="problem">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16"/><path d="M4 19V9l8-5 8 5v10"/><path d="M9 19v-6h6v6"/></svg></span>
            <h3>No shared data</h3>
            <p>Cycle apps guess from calendars; smartwatches sit on the wrist, far from where it matters.</p>
          </div>
        </div>

        <div class="juggle">
          <b>Today that is</b>
          <span class="chip">Menstrual underwear</span><span class="arrow">+</span>
          <span class="chip">Sanitary pads</span><span class="arrow">+</span>
          <span class="chip">Heating pads</span><span class="arrow">+</span>
          <span class="chip">Tracking apps</span>
          <span class="arrow">→</span> <b>one platform: MIMA</b>
        </div>
      </div>
    </section>

    <section id="anatomy">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">The product</span>
          <h2>A garment engineered to do the work</h2>
          <p>
            The undergarment is not just a carrier — its high-waisted architecture holds the
            sustained skin contact that stable textile sensing needs, while a detachable module
            snaps into a dedicated pocket.
          </p>
        </div>

        <div class="anatomy">
          <figure>
            <picture>
              <source srcset="/projects/mima/assets/anatomy.webp" type="image/webp" />
              <img src="/projects/mima/assets/anatomy.png" alt="Labelled front and back view of the MIMA garment showing the control module, heat-pad, battery and PCB in a front pocket, the leak-proof multilayer gusset, and wing-pockets that hold sanitary-pad wings." width="1800" height="900" />
            </picture>
            <figcaption>Front and back of the specialised undergarment with the detachable IoT module in place.</figcaption>
          </figure>
          <ul class="callouts">
            <li>High-waisted construction for a stable, discreet fit</li>
            <li>Heat-pad pocket seats a detachable control module — PCB, battery, heater</li>
            <li>Leak-proof multilayer gusset</li>
            <li>Wing-pockets receive sanitary-pad wings, holding adhesive off the skin</li>
            <li>Antibacterial fabric to fight rashes and malodor</li>
            <li>Everything washable once the module is removed</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="alt" id="architecture">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Architecture</span>
          <h2>Three nodes, one ecosystem</h2>
          <p>The invention has three distinct nodes that work together as a single coordinated system.</p>
        </div>

        <div class="nodes">
          {nodes.map((n) => (
            <div class="node">
              <span class="tag">{n.tag}</span>
              <h3>{n.title}</h3>
              <ul>{n.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="loop">
      <div class="wrap narrow">
        <div class="section-head">
          <span class="eyebrow">Closed-loop heat therapy</span>
          <h2>Heat that responds to the cramp</h2>
          <p>
            A manual heating pad has one setting: whatever you last turned it to. MIMA's textile
            sEMG sensors read the real-time intensity of abdominal muscle contractions, and the
            module scales its own heat to match — automatically.
          </p>
        </div>
        <div class="loop">
          <div class="step"><span class="n">1</span><p>Textile sEMG senses abdominal muscle activity</p></div>
          <div class="step"><span class="n">2</span><p>Controller estimates cramp onset &amp; intensity</p></div>
          <div class="step"><span class="n">3</span><p>Heater actuation &amp; temperature scale to match</p></div>
          <div class="step"><span class="n">4</span><p>Relief is logged; the loop keeps adapting</p></div>
        </div>
      </div>
    </section>

    <section class="alt" id="novelty">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Why it is different</span>
          <h2>Novelty highlights</h2>
          <p>The value is in the integration — features that only work because the others are there too.</p>
        </div>
        <div class="novelty-grid">
          {novelty.map((n) => (
            <div class="nv">
              <h3>{n.title}</h3>
              <p>{n.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="compare">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">At a glance</span>
          <h2>MIMA vs. the usual kit</h2>
        </div>
        <div class="table-scroll">
          <table class="cmp">
            <thead>
              <tr><th>Capability</th><th>Separate products</th><th>MIMA</th></tr>
            </thead>
            <tbody>
              {compare.map((row) => (
                <tr><td>{row[0]}</td><td>{row[1]}</td><td>{row[2]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="alt" id="app">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">The app</span>
          <h2>The whole system in your pocket</h2>
          <p>
            A working front-end demo of the MIMA app is live — every screen is interactive with
            realistic sample data. No real device, backend, or personal data.
          </p>
        </div>
        <div class="app">
          <div class="app-card">
            <h3>Open the interactive demo</h3>
            <p>
              Explore device control, insights, the community forum, teleconsultation and the
              emergency SOS flow — in light or dark mode.
            </p>
            <a class="btn btn-ghost" href="/projects/mima/demo/">Launch demo app →</a>
          </div>
          <ul class="screens">
            {screens.map((s) => (
              <li><b>{s[0]}</b><p>{s[1]}</p></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="patent">
      <div class="wrap narrow">
        <div class="section-head">
          <span class="eyebrow">Status</span>
          <h2>Intellectual property</h2>
        </div>
        <div class="patent-box">
          <p>
            MIMA is the subject of <span class="num">Indian Patent Application No. {patentNo}</span>
            (“Multifunctional IoT-Based Menstrual Aid for Menstrual Health and Comfort”), filed in
            2025 by Jyothish Kumar J <em>et al.</em>
          </p>
          <p>
            Following the First Examination Report and a written response, the application is
            <strong> currently in hearing before the Indian Patent Office</strong>. The claims cover
            the integrated garment-plus-module-plus-app system, the closed-loop sEMG-driven heat
            control, and the multi-parameter physiological analytics.
          </p>
          <p>
            Associated peer-reviewed publications are listed on the
            <a href="https://jyozspace.in/research/">research page</a>.
          </p>
        </div>
      </div>
    </section>

    <footer>
      <div class="wrap foot-inner">
        <div>
          <strong>MIMA</strong> — Multifunctional IoT Integrated Menstrual Aid<br />
          Concept, system design &amp; app by Jyothish Kumar J <em>et al.</em><br />
          National Institute of Fashion Technology, Bhubaneswar
        </div>
        <div class="foot-links">
          <a href="/projects/mima/demo/">Demo app</a>
          <a href="https://jyozspace.in/projects/">Projects</a>
          <a href="https://jyozspace.in/research/">Research</a>
          <a href="https://jyozspace.in/contact/">Contact</a>
        </div>
      </div>
      <div class="wrap disclaimer">
        This page is a product overview for a patent-pending concept. The linked application is a
        front-end demo only — it does not connect to a real device or collect any data.
      </div>
    </footer>
  </body>
</html>
