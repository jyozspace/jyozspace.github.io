---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Jyothish J. Kumar — a chemistry graduate turned self-taught full-stack roboticist. Embedded systems, ROS2, and robotic systems design.',
  image = '/images/favicon-192.png',
} = Astro.props;

const pageTitle = title === 'JyozSpace' ? title : `${title} · JyozSpace`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Set theme before first paint to avoid a flash of the wrong theme.
      // Always resolve to an explicit 'dark'/'light' — even with no stored
      // preference — so data-theme matches what's actually rendered (the
      // dark CSS also activates via prefers-color-scheme when unset). If
      // this only set the attribute for a *stored* preference, a first-time
      // dark-OS visitor would render dark while data-theme stayed absent,
      // leaving ThemeToggle's icon (which keys off data-theme='dark') stuck
      // showing light until clicked twice.
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
